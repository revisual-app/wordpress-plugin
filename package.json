{
  "name": "revisual",
  "version": "1.0.1",
  "description": "Easily embed your Revisual widgets.",
  "author": "The WordPress Contributors",
  "license": "GPL-2.0-or-later",
  "main": "build/index.js",
  "scripts": {
    "build": "wp-scripts build",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "packages-update": "wp-scripts packages-update",
    "plugin-zip": "wp-scripts plugin-zip",
    "start": "wp-scripts start",
    "install-deps": "docker image inspect rev-wp-install-img >/dev/null 2>&1 || docker build -t rev-wp-install-img . && docker run --rm -v \"$(pwd)\":/app rev-wp-install-img"
  },
  "devDependencies": {
    "@wordpress/scripts": "^26.19.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@wordpress/components": "^25.8.0",
    "@wordpress/blocks": "^12.17.0",
    "axios": "^1.19.0",
    "js-md5": "^0.9.2",
    "react-redux": "^9.3.0",
    "redux-logger": "^3.0.6",
    "redux-persist": "^6.0.0",
    "sonner": "^2.0.8"
  },
  "files": [
    "assets",
    "build",
    "config",
    "includes",
    "public",
    "vendor",
    "src",
    "*.php",
    "*.css",
    "*.js",
    "*.txt",
    "*.json",
    "*.md"
  ]
}
